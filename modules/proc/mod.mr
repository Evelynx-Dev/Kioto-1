// Kioto 3.0.0 — proc module.
//
// Process execution is argv-based: run::create, run::spawn, run::output and
// run::output_cwd pass an argument vector straight to execvp, so nothing is
// ever re-parsed by /bin/sh and a filename containing a space or a semicolon
// stays one argument.
//
// proc::shell is the one deliberate exception. A shell takes a string, so
// every metacharacter in that string is a command-injection vector — which is
// why it is a separate, named, denied-by-default symbol rather than a
// parameter on the argv functions. See the shell section at the bottom.

module proc
load kioto::proc::_externs

// A spawned child. The struct is a thin wrapper around the PAL handle, not a
// live object: copying the struct copies the handle, and close is what releases
// the descriptor. Treat one Process as one resource.

pub struct Process {
    handle :i64
}

// Pass this as the flags argument of run::create to block until the child
// exits. Any other value starts the child and returns immediately, leaving the
// exit status to be collected later by proc::wait.

cons PAL_SPAWN_WAIT = 1 :i32

// The four ways to start a program, and the three questions you ask about one
// that just ran. The grouping is the point: creating a process and asking
// what happened to it are different acts, and the answers belong together.
pub fn run: () {
    // The low-level form: raw flags plus three channel handles, one per stream.
    // Pass 0 for a stream to leave it inherited, which is what makes a child's
    // output land on this process's own stdout. A returned handle of 0 or less
    // means the fork failed and there is nothing to close.

    pub fn create: (cmd :&str, args :vec[str], flags :i32, stdin_ch :i64, stdout_ch :i64, stderr_ch :i64) :Process {
        set argv = rt_build_argv(cmd, args)
        set argc = rt_vec_len(args) + 1
        set h = pal_proc_create(argv, flags, stdin_ch, stdout_ch, stderr_ch)
        use rt_free_argv(argv, argc)
        return (Process handle: h)
    }

    // Runs a command to completion and returns its exit status. Nothing is
    // captured: the child writes to this process's stdout and stderr, so the
    // output shows up in the terminal rather than in a string. Returns -1 when
    // the child could not be forked at all, 127 when exec failed, and otherwise
    // the status of the child.

    pub fn spawn: (cmd :&str, args :vec[str]) :i64 {
        set argv = rt_build_argv(cmd, args)
        set argc = rt_vec_len(args) + 1
        set h = pal_proc_create(argv, 1 :i32, 0, 0, 0)
        use rt_free_argv(argv, argc)
        if h <= 0 { return -1 }
        set exit_code = pal_proc_wait(h)
        use pal_proc_close(h)
        return exit_code
    }

    // Captures stdout as an owned string and waits for the child. On every
    // failure path — a bad argument, a failed pipe, a failed fork — the result
    // is the empty string, and so is a command that simply printed nothing.
    // Check proc::run::last_exit() to tell those apart.
    // Read end of the child's stdout, for use with async::channel::recv.

    pub fn output: (cmd :&str, args :vec[str]) :str {
        return rt_proc_capture_argv(cmd, args)
    }

    // Captures stdout from a command started in a specific directory. cwd is
    // applied with chdir before exec, and a cwd that cannot be entered makes the
    // child exit 126. merge_err folds stderr into the same pipe, which is the
    // shape to reach for when the only evidence of failure is on stderr.
    // output with the working directory set, and the option to fold the child's
    // stderr into the same capture. A bad working directory exits 126.
    pub fn output_cwd: (cmd :&str, args :vec[str], cwd :&str, merge_err :bool) :str {
        set flag = 0 :i64 mut
        if merge_err { set flag = 1 }
        return rt_proc_capture_argv2(cmd, args, cwd, flag)
    }

    // Exit status of the last proc::run::output or proc::run::output_cwd call in
    // this thread, or -1 if no call has completed yet. This is the only reliable
    // success signal for a captured run: the captured string is empty both when
    // the command failed and when the command legitimately printed nothing.

    // The exit status of the last captured process, thread-local. This is the
    // only reliable success check: output can be empty for a command that
    // succeeded perfectly.
    pub fn last_exit: () :i64 {
        return rt_proc_last_exit()
    }

    // Reads a line from /dev/tty directly, without spawning a subprocess.
    // Returns "y" when there is no terminal, which keeps Y/n prompts safe.
    // A line typed by the user, read straight from /dev/tty so no subprocess is
    // involved. Falls back to "y" when there is no terminal, which is what
    // makes a Y/n prompt answer itself in a pipeline or under a test runner.

    // One line read from the terminal, bypassing the captured-output path so it
    // works while a prompt is waiting. Returns "y" when there is no
    // terminal, which makes an unattended run take the default branch.
    pub fn read_line: () :str {
        return rt_read_tty()
    }
}

// Blocks until the child exits and returns its status. Calling it on a child
// that was already waited on returns -1 rather than hanging.

pub fn wait: (p :Process) :i64 {
    return pal_proc_wait(p.handle)
}

// Sends a termination signal to the child. True when the signal was delivered,
// false when the child was already gone or is not ours to signal.

pub fn kill: (p :Process) :bool {
    return pal_proc_kill(p.handle) != 0
}

// Releases the handle. Nothing about the child changes; this only gives the
// descriptor back. Skipping it leaks one descriptor per spawn.

pub fn close: (p :Process) {
    use pal_proc_close(p.handle)
}

// The three standard streams of a child, as raw channel handles. They are
// channels rather than strings so the caller decides whether to read them
// synchronously or hand them to another thread; see async::channel.
pub fn stream: () {
    // Write end of the child's stdin, as a raw channel handle. Only meaningful
    // when run::create was given a non-zero handle for that stream.

    pub fn input: (p :Process) :i64 {
        return pal_proc_stdin(p.handle)
    }

    pub fn output: (p :Process) :i64 {
        return pal_proc_stdout(p.handle)
    }

    // Read end of the child's stderr, for use with async::channel::recv.

    pub fn error: (p :Process) :i64 {
        return pal_proc_stderr(p.handle)
    }
}

// ══ SHELL ═══════════════════════════════════════════════════
// Runs `command` through /bin/sh -c and returns the child's combined stdout
// and stderr, with the exit status available from shell_status.
//
// The shell exists because some work genuinely needs it — pipelines, globbing,
// redirection, `&&` chains — and a package that pretended otherwise would just
// push callers back to writing their own `sh -c`. The cost is that the whole
// command string is one injection surface, so the exposure is made explicit:
//
//   * DENIED BY DEFAULT. A call without an open unsafe scope fails with
//     PAL_ERR_PERMISSION from fs::last_error(). It does not silently no-op.
//   * EXPLICIT AT THE CALL SITE. To use it you have to write
//     fs::unsafe::enter() ... fs::unsafe::exit() around it. The grant is
//     visible in the source, which is the whole point of gating it.
//   * NEVER BUILD THE COMMAND FROM UNTRUSTED INPUT. For "run this program with
//     these arguments", run::output takes an argv vector and has no parsing
//     step to get wrong.
//
// The call is SYNCHRONOUS and has NO TIMEOUT: it returns when the shell exits.
// There is deliberately no timeout parameter rather than one that cannot be
// honoured, because a deadline argument that does not kill anything is worse
// than no argument — it reads as a guarantee. If you need a real deadline, use
// run::spawn plus a channel and kill the handle when it expires.
pub fn shell: (command :&str) :str {
    return rt_proc_shell(command)
}

// The exit status of the last proc::shell on this thread: the shell's exit
// code, 128+signal if it was killed, or -1 if the call was denied or never
// made. Independent of whether the captured output looks like a success.
pub fn shell_status: () :i64 {
    return pal_proc_shell_status()
}
