module ed25519

load kioto::strings
load kioto::fs

// A private key held in memory. The only thing that can sign with it, and
// the reason close exists: the handle goes back to the crypto library when
// you close it, and not before.
pub struct SecretKey {
    handle :i64
}

// The public half of a key pair, which verifies and is safe to publish.
pub struct PublicKey {
    handle :i64
}

extern fn pal_secret_create: (algorithm :i64) :i64 lib "c"
extern fn pal_secret_export_public: (secret :i64) :i64 lib "c"
extern fn pal_secret_sign: (secret :i64, msg :&str, msg_len :i64, buf :&mut str, buf_len :i64) :i64 lib "c"
extern fn pal_pubkey_verify: (pubkey :i64, msg :&str, msg_len :i64, sig :&str, sig_len :i64) :bool lib "c"
extern fn rt_crypto_ed25519_verify_b64: (pubkey_b64 :&str, data_file :&str, sig_b64 :&str) :bool lib "c"
extern fn rt_crypto_ed25519_verify_file: (pubkey_b64 :&str, data_file :&str, sig_file :&str) :bool lib "c"
extern fn rt_crypto_ed25519_pubkey_raw_b64: (pem_path :&str) :str lib "c"
extern fn pal_secret_close: (secret :i64) lib "c"
extern fn pal_pubkey_free: (pubkey :i64) lib "c"

cons PAL_CRYPTO_ED25519 = 1 :i64

// The private half, and the only asymmetric signing this module offers.
pub fn secret: () {
    // A fresh key pair from the system entropy source.
    pub fn new: () :SecretKey {
        set h = pal_secret_create(1 :i64)
        return (SecretKey handle: h)
    }

    // The public key that matches a secret key.
    pub fn public: (secret :SecretKey) :PublicKey {
        set h = pal_secret_export_public(secret.handle)
        return (PublicKey handle: h)
    }

    // Signs a message, returning the signature as the raw 64 bytes the
    // algorithm produces, or an empty string if signing failed.
    //
    // Raw, not base64, so that it pairs with verify below, which reads a raw
    // signature. A signature is arbitrary binary and about one in five of them
    // contains a NUL byte, which is why the base64 forms are separate
    // functions: a raw signature is not safe to store in a string, write to a
    // file as text, or print. To put one in a file, encode it yourself, or
    // hand the work to verify_file.
    pub fn sign: (secret :SecretKey, msg :&str) :str {
        set msg_len = strings::len(msg)
        set buf = strings::repeat("\0" 64) :str mut
        set sig_len = pal_secret_sign(secret.handle, msg, msg_len, buf, 64)
        if sig_len == 64 { return buf }
        return ""
    }

    // Releases the secret key. After this the signature it produced is the only
    // copy of anything that can reproduce it.
    // Releases the public key handle.
    pub fn close: (secret :SecretKey) {
        use pal_secret_close(secret.handle)
    }
}

// The public half, for the side that only checks.
pub fn public: () {
    // Whether a signature is this key's signature over this message. The
    // signature is the raw 64 bytes sign produces, not base64; the base64
    // forms live in verify_b64 and verify_file below.
    pub fn verify: (pubkey :PublicKey, msg :&str, sig :&str) :bool {
        set msg_len = strings::len(msg)
        set sig_len = strings::len(sig)
        return pal_pubkey_verify(pubkey.handle, msg, msg_len, sig, sig_len)
    }

    /! Verifies a detached Ed25519 signature supplied as base64 against the
       binary contents of `data_file` and a base64 raw public key (32 bytes).
       Everything is decoded in the runtime binding; no shell or temp files. !/
    // The same check, reading the message from a file and the public key as
    // base64 rather than as a handle. This is the shape a registry or a
    // lockfile check uses, where nothing is loaded into memory first.
    pub fn verify_b64: (pubkey_b64 :&str, data_file :&str, sig_b64 :&str) :bool {
        if pubkey_b64 == "" || sig_b64 == "" { return false }
        return rt_crypto_ed25519_verify_b64(pubkey_b64, data_file, sig_b64)
    }

    /! Same as verify_b64 but the signature is a raw 64-byte file. !/
    // As verify_b64, with the signature in a file too.
    pub fn verify_file: (pubkey_b64 :&str, data_file :&str, sig_file :&str) :bool {
        if pubkey_b64 == "" { return false }
        return rt_crypto_ed25519_verify_file(pubkey_b64, data_file, sig_file)
    }

    /! Reads a PEM-encoded Ed25519 public key file and returns its raw 32-byte
       key as base64 (the form the registry/publish manifests use). "" on error. !/
    // The raw key bytes of a PEM file, base64 encoded, which is the form
    // verify_b64 expects.
    pub fn raw_b64_from_pem: (pem_path :&str) :str {
        if !fs::exists(pem_path) { return "" }
        return rt_crypto_ed25519_pubkey_raw_b64(pem_path)
    }

    pub fn close: (pubkey :PublicKey) {
        use pal_pubkey_free(pubkey.handle)
    }
}
