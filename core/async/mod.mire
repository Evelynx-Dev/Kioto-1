module async

struct Channel {
    handle :i64
}

extern fn pal_channel_create: () :i64 lib "c"
extern fn pal_channel_send: (ch :i64, data :&str, len :i64) :i64 lib "c"
extern fn pal_channel_recv: (ch :i64, buf :&mut str) :i64 lib "c"
extern fn pal_channel_close: (ch :i64) lib "c"

pub fn channel_create: () :Channel {
    set h = pal_channel_create()
    return (Channel handle: h)
}

pub fn channel_send: (ch :Channel, data :&str) :i64 {
    return pal_channel_send(ch.handle, data, len(data))
}

pub fn channel_recv: (ch :Channel, buf :&mut str) :i64 {
    return pal_channel_recv(ch.handle, buf)
}

pub fn channel_close: (ch :Channel) {
    use pal_channel_close(ch.handle)
}
