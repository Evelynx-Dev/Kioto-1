// math::stats - one test per symbol.
//
// The data is small integers, so most expected values are halves and quarters
// that binary64 represents exactly, and those are asserted with exact equality.
// A tolerance there would not make the tests more robust, it would only make
// them weaker: a variance off by a whole percent would still pass 1e-9.
//
// The exceptions are the three that go through a square root. A correlation of a
// list with itself is 1 in exact arithmetic, but computing it divides a variance
// by the square of its own standard deviation, and that lands a couple of ulp
// away from 1. Those are compared with close_to, at a tolerance far tighter than
// any of the arithmetic could drift on its own.
//
// The three order statistics that need a sorted list (median, percentile, and
// mode's counts) are all checked against a list that arrives unsorted, because a
// median that only works on sorted input is a lookup, not a median.

load kioto
load mire::vec

// |a - b| <= eps, for the values that are not exactly representable.
fn close_to: (a :f64, b :f64, eps :f64) :bool {
    set d = a - b :f64 mut
    if d < 0.0 { set d = 0.0 - d }
    return d <= eps
}

@[test]
pub fn mean_is_the_total_over_the_count: () :bool {
    // (1 + 2 + 3 + 4) / 4
    if math::stats::mean([1 2 3 4] :vec[i64]) != 2.5 { return false }
    return math::stats::mean([7] :vec[i64]) == 7.0
}

@[test]
pub fn mean_of_an_empty_list_is_zero: () :bool {
    return math::stats::mean([] :vec[i64]) == 0.0
}

@[test]
pub fn median_of_an_odd_count_is_the_middle: () :bool {
    // 5 1 3 is 1 3 5 sorted, so the middle is 3
    if math::stats::median([5 1 3] :vec[i64]) != 3.0 { return false }
    return math::stats::median([1 1 1] :vec[i64]) == 1.0
}

@[test]
pub fn median_of_an_even_count_averages_the_two_middles: () :bool {
    // 4 1 3 2 is 1 2 3 4 sorted, so the middles are 2 and 3
    if math::stats::median([4 1 3 2] :vec[i64]) != 2.5 { return false }
    // A single pair has no middle of its own; the answer is the midpoint
    return math::stats::median([1 4] :vec[i64]) == 2.5
}

@[test]
pub fn median_leaves_the_caller_list_alone: () :bool {
    // The sort happens on a copy. If it did not, this second read of the same
    // list would come back reordered and the test would catch it.
    set list = [9 7 8] :vec[i64]
    set before = vec::len(list) :i64
    set m = math::stats::median(list) :f64
    if m != 8.0 { return false }
    if vec::get::i64(list, 0) != 9 { return false }
    if vec::get::i64(list, 1) != 7 { return false }
    return vec::len(list) == before
}

@[test]
pub fn variance_is_the_mean_squared_deviation: () :bool {
    // The mean of 2 4 4 4 5 5 7 9 is 5. The squared deviations are 9 1 1 1 0
    // 0 4 16, and they average 32/8 = 4. This is the textbook example, chosen
    // because the answer is a whole number and no rounding can hide in it.
    return math::stats::variance([2 4 4 4 5 5 7 9] :vec[i64]) == 4.0
}

@[test]
pub fn variance_of_a_constant_list_is_zero: () :bool {
    // Every deviation is zero, so the variance is exactly zero. A nonzero answer
    // here would mean the mean was computed wrong.
    return math::stats::variance([3 3 3 3] :vec[i64]) == 0.0
}

@[test]
pub fn stddev_is_the_root_of_the_variance: () :bool {
    // The same list, whose variance is 4, so the standard deviation is 2
    set list = [2 4 4 4 5 5 7 9] :vec[i64]
    if math::stats::stddev(list) != 2.0 { return false }
    return math::stats::stddev([3 3 3 3] :vec[i64]) == 0.0
}

@[test]
pub fn mode_is_the_most_frequent_value: () :bool {
    // 3 appears twice and everything else once
    if math::stats::mode([1 3 2 3] :vec[i64]) != 3 { return false }
    return math::stats::mode([5 5 5 5] :vec[i64]) == 5
}

@[test]
pub fn mode_breaks_a_tie_with_the_smaller_value: () :bool {
    // 1 and 2 both appear twice, so the tie has to resolve to a number that is a
    // function of the data. The smaller one is the answer, and the test fails if
    // it starts depending on the order the counts were accumulated in.
    return math::stats::mode([1 2 1 2] :vec[i64]) == 1
}

@[test]
pub fn mode_of_a_list_with_no_repeats_is_the_first_value: () :bool {
    // Every value appears once, so they all tie at one and the smaller wins.
    // 4 2 3 has 2 as the smallest of them.
    return math::stats::mode([4 2 3] :vec[i64]) == 2
}

@[test]
pub fn minVal_is_the_smallest_observation: () :bool {
    if math::stats::minVal([5 1 9 3] :vec[i64]) != 1 { return false }
    return math::stats::minVal([-4 0 4] :vec[i64]) == -4
}

@[test]
pub fn maxVal_is_the_largest_observation: () :bool {
    if math::stats::maxVal([5 1 9 3] :vec[i64]) != 9 { return false }
    return math::stats::maxVal([-4 0 -9] :vec[i64]) == 0
}

@[test]
pub fn minVal_and_maxVal_of_an_empty_list_are_zero: () :bool {
    if math::stats::minVal([] :vec[i64]) != 0 { return false }
    return math::stats::maxVal([] :vec[i64]) == 0
}

@[test]
pub fn percentile_interpolates_between_order_statistics: () :bool {
    // 1 2 3 4 sorted. The scale is the n-1 gaps between the observations, so p
    // lands at p/100 of the way along three gaps from 1: p = 50 is 1.5 gaps in,
    // which is 2.5, and p = 25 is 0.75 gaps in, which is 1.75.
    if math::stats::percentile([1 2 3 4] :vec[i64], 50.0) != 2.5 { return false }
    return math::stats::percentile([1 2 3 4] :vec[i64], 25.0) == 1.75
}

@[test]
pub fn percentile_at_the_ends_is_the_observation_itself: () :bool {
    // 0 and 100 are the ends of the scale, which are the observations and not a
    // point between them, so there is nothing to interpolate.
    set list = [4 1 3 2] :vec[i64]
    if math::stats::percentile(list, 0.0) != 1.0 { return false }
    if math::stats::percentile(list, 100.0) != 4.0 { return false }
    return math::stats::percentile(list, 50.0) == 2.5
}

@[test]
pub fn percentile_clamps_a_value_outside_the_scale: () :bool {
    // A caller computing a percentile from a ratio should not have to range
    // check first, so out of range clamps to the ends rather than failing.
    set list = [1 2 3 4] :vec[i64]
    if math::stats::percentile(list, -10.0) != 1.0 { return false }
    return math::stats::percentile(list, 150.0) == 4.0
}

@[test]
pub fn percentile_agrees_with_median_at_fifty: () :bool {
    // The two answer the same question by different routes, so this pins them
    // together: median sorts and takes the middle, percentile sorts and walks the
    // scale. If either drifts they drift apart.
    set list = [3 1 4 1 5 9 2 6] :vec[i64]
    return math::stats::percentile(list, 50.0) == math::stats::median(list)
}

@[test]
pub fn covariance_is_positive_when_the_lists_move_together: () :bool {
    // Both lists are 1 2 3 centred on 2, so the products of the deviations are
    // 1 0 1 and the mean of them is 2/3.
    if !close_to(math::stats::covariance([1 2 3] :vec[i64], [1 2 3] :vec[i64]), 0.6666666666666666, 1e-12) { return false }
    // x rising as y falls gives a negative covariance
    return close_to(math::stats::covariance([1 2 3] :vec[i64], [3 2 1] :vec[i64]), -0.6666666666666666, 1e-12)
}

@[test]
pub fn covariance_of_an_independent_pair_is_zero: () :bool {
    // The deviations of y are -1 0 1 and the deviations of x are 0 0 0, so
    // every product is zero whatever the pairing.
    return math::stats::covariance([2 2 2] :vec[i64], [1 2 3] :vec[i64]) == 0.0
}

@[test]
pub fn corr_of_a_list_with_itself_is_one: () :bool {
    // The coefficient of correlation of anything with itself is 1, and this is
    // the sharpest check available: the covariance divided by the spread squared.
    set list = [1 2 3 4 5] :vec[i64]
    return close_to(math::stats::corr(list, list), 1.0, 1e-12)
}

@[test]
pub fn corr_is_minus_one_when_the_lists_run_opposite: () :bool {
    // y is x reversed, so every deviation pairs with its negation
    return close_to(math::stats::corr([1 2 3 4 5] :vec[i64], [5 4 3 2 1] :vec[i64]), -1.0, 1e-12)
}

@[test]
pub fn corr_of_a_flat_list_is_zero: () :bool {
    // A list that never varies has no spread to divide by, so the coefficient
    // is undefined. The answer here is 0, meaning no measurable relationship,
    // and the test is what keeps that from turning into a NaN.
    return math::stats::corr([2 2 2 2] :vec[i64], [1 2 3 4] :vec[i64]) == 0.0
}

@[test]
pub fn corr_ignores_the_scale_of_the_lists: () :bool {
    // The same relationship, one list ten times taller. The covariance scales by
    // ten and the spread scales by ten, so the coefficient must not move.
    set x = [1 2 3 4 5] :vec[i64]
    set y = [10 20 30 40 50] :vec[i64]
    if !close_to(math::stats::corr(x, y), 1.0, 1e-12) { return false }
    return close_to(math::stats::corr(x, [2 4 6 8 10] :vec[i64]), 1.0, 1e-12)
}
